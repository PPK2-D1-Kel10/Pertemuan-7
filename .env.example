# =======================================================
# Konfigurasi Lingkungan PraktiKu (Sprint 2)
# =======================================================
# Salin file ini menjadi .env dan isi dengan kredensial
# proyek Firebase khusus Sprint 2 Anda.
# JANGAN gunakan project personal atau proyek lain.

# Konfigurasi Web App Firebase (Dari Firebase Console > Project Settings > General > Your Apps)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyContohKeyProyekFirebaseSprint2
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=praktiku-sprint2.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=praktiku-sprint2
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=praktiku-sprint2.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Opsional: URL Backend Proxy AI Tepercaya (Tidak Menyimpan API Key di Klien)
# Untuk pengujian lokal dengan proxy: http://localhost:3001/api/classify
EXPO_PUBLIC_AI_API_URL=
