rules_version = '2';

// Combined Firestore Security Rules: ZerovaApp + Sprint 2 Namespace (sprint2Data/app)
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 0. GLOBAL HELPER FUNCTIONS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    function getSprint2UserData(uid) {
      return get(/databases/$(database)/documents/sprint2Data/app/users/$(uid)).data;
    }

    function isSprint2Assistant() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/sprint2Data/app/users/$(request.auth.uid))
        && (getSprint2UserData(request.auth.uid).role == 'asisten' || getSprint2UserData(request.auth.uid).role == 'Asisten');
    }

    // =========================================================================
    // 1. LEGACY APP RULES (ZEROVAAPP / POJECT-POSTUTS)
    // Tetap utuh 100% untuk menjaga kompatibilitas aplikasi sebelumnya
    // =========================================================================
    // Data mahasiswa (fitur lama): user login boleh membaca, super_admin boleh menulis
    match /mahasiswa/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Dokumen role lama: users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // =========================================================================
    // 2. SPRINT 2 NAMESPACE RULES: sprint2Data/app/...
    // Terisolasi penuh dari aplikasi lama, dengan otorisasi khusus praktikan & asisten
    // =========================================================================
    match /sprint2Data/app {

      // --- SUBKOLEKSI: USERS ---
      match /users/{uid} {
        allow read: if isSignedIn();
        // Registrasi publik hanya boleh membuat akun praktikan
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && (request.resource.data.role == 'praktikan' || request.resource.data.role == 'Praktikan');
        // Praktikan dilarang menaikkan perannya sendiri menjadi asisten
        allow update: if isSignedIn()
          && request.auth.uid == uid
          && (
            request.resource.data.role == resource.data.role ||
            isSprint2Assistant()
          );
        allow delete: if false;
      }

      // --- SUBKOLEKSI: CLASSES ---
      match /classes/{classId} {
        allow read: if isSignedIn();
        allow create: if isSprint2Assistant() && request.resource.data.assistantUid == request.auth.uid;
        allow update, delete: if isSprint2Assistant() && resource.data.assistantUid == request.auth.uid;
      }

      // --- SUBKOLEKSI: ENROLLMENTS ---
      match /enrollments/{enrollmentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSprint2Assistant();
      }

      // --- SUBKOLEKSI: SESSIONS ---
      match /sessions/{sessionId} {
        allow read: if isSignedIn();
        allow create: if isSprint2Assistant() && request.resource.data.assistantUid == request.auth.uid;
        allow update, delete: if isSprint2Assistant() && resource.data.assistantUid == request.auth.uid;
      }

      // --- SUBKOLEKSI: ATTENDANCE ---
      match /attendance/{attendanceId} {
        allow read: if isSignedIn();
        // Presensi hanya oleh mahasiswa yang login, pada sesi open, dengan ID deterministik
        allow create: if isSignedIn()
          && request.resource.data.studentUid == request.auth.uid
          && attendanceId == request.resource.data.sessionId + '_' + request.auth.uid
          && get(/databases/$(database)/documents/sprint2Data/app/sessions/$(request.resource.data.sessionId)).data.status in ['open', 'Berlangsung'];
        // Data presensi bersifat immutable (tidak boleh diubah atau dihapus)
        allow update, delete: if false;
      }

      // --- SUBKOLEKSI: LEAVE REQUESTS ---
      match /leaveRequests/{leaveId} {
        allow read: if isSignedIn();
        // Mahasiswa hanya boleh membuat izin berstatus pending untuk UID miliknya sendiri
        allow create: if isSignedIn()
          && request.resource.data.studentUid == request.auth.uid
          && request.resource.data.status == 'pending'
          && leaveId == request.resource.data.sessionId + '_' + request.auth.uid;
        // Asisten boleh approve/reject. Mahasiswa dilarang approve izin sendiri atau mengubah field AI
        allow update: if isSignedIn() && (
          isSprint2Assistant() ||
          (
            request.auth.uid == resource.data.studentUid &&
            resource.data.status == 'pending' &&
            request.resource.data.status == 'pending' &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'reviewedBy', 'reviewNotes', 'aiCategory', 'aiConfidence', 'aiStatus', 'aiExplanation'])
          )
        );
        allow delete: if isSprint2Assistant();
      }
    }

    // =========================================================================
    // 3. DEFAULT DENY
    // Semua koleksi atau path di luar mahasiswa, users, dan sprint2Data/app ditolak
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
